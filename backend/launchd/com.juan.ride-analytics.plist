<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.juan.ride-analytics</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/juanramirez/learning/riders-attendance/.venv/bin/python</string>
        <string>scrape.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/juanramirez/learning/riders-attendance/backend/scraper</string>

    <!-- Every Tuesday at 09:00. launchd runs it on wake if the machine was asleep. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>2</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/juanramirez/learning/riders-attendance/data/scrape.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/juanramirez/learning/riders-attendance/data/scrape.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
